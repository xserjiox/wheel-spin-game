generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  LOBBY
  SPINNING
  CLOSED
}

enum ParticipantRole {
  HOST
  GUEST
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SelectionMode {
  REPEAT
  ELIMINATION
}

model Room {
  id              String        @id @default(uuid())
  code            String        @unique
  title           String
  passwordHash    String?
  selectionMode   SelectionMode @default(REPEAT)
  status          RoomStatus    @default(LOBBY)
  version         Int           @default(1)
  currentRotation Float         @default(0)
  activeSpinId    String?
  createdAt       DateTime      @default(now())
  lastActivityAt  DateTime      @default(now())
  expiresAt       DateTime
  participants    Participant[]
  options         Option[]
  proposals       Proposal[]
  spins           Spin[]

  @@index([expiresAt])
}

model Participant {
  id             String          @id @default(uuid())
  roomId         String
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  displayName    String
  normalizedName String
  role           ParticipantRole
  canSpin        Boolean         @default(false)
  sessionHash    String          @unique
  connectedAt    DateTime        @default(now())
  lastSeenAt     DateTime        @default(now())
  proposals      Proposal[]

  @@unique([roomId, normalizedName])
  @@index([roomId])
}

model Option {
  id         String    @id @default(uuid())
  roomId     String
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label      String
  weight     Decimal   @default(1.00) @db.Decimal(7, 2)
  position   Int
  excludedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([roomId, position])
  @@index([roomId])
  @@index([roomId, excludedAt])
}

model Proposal {
  id            String         @id @default(uuid())
  roomId        String
  room          Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  label         String
  status        ProposalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  reviewedAt    DateTime?

  @@index([roomId, status])
  @@index([participantId, status])
}

/// Anonymous totals of expired rooms, grouped by the UTC day they were created.
/// Rows are added right before expired rooms are deleted, so history survives cleanup.
model DailyRoomStat {
  day                DateTime @db.Date
  hasPassword        Boolean
  rooms              Int      @default(0)
  roomsWithGuests    Int      @default(0)
  liveRooms          Int      @default(0)
  soloSpunRooms      Int      @default(0)
  abandonedRooms     Int      @default(0)
  guests             Int      @default(0)
  maxGuests          Int      @default(0)
  participants1      Int      @default(0)
  participants2to4   Int      @default(0)
  participants5to11  Int      @default(0)
  participants12to31 Int      @default(0)
  participants32to49 Int      @default(0)
  participants50plus Int      @default(0)

  @@id([day, hasPassword])
}

model Spin {
  id              String   @id @default(uuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  requestId       String
  optionsSnapshot Json
  winnerOptionId  String
  winnerIndex     Int
  winnerLabel     String
  startedAt       DateTime
  durationMs      Int
  finalRotation   Float
  createdAt       DateTime @default(now())

  @@unique([roomId, requestId])
  @@index([roomId, createdAt])
}
