DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatherwheel
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
REDIS_PREFIX=gatherwheel:development
APP_ENV=development
RATE_LIMIT_CREATE_MAX=5
RATE_LIMIT_CREATE_WINDOW_MS=600000
RATE_LIMIT_JOIN_REQUEST_MAX=30
RATE_LIMIT_JOIN_REQUEST_WINDOW_MS=300000
RATE_LIMIT_JOIN_FAILURE_MAX=8
RATE_LIMIT_JOIN_FAILURE_WINDOW_MS=300000
RATE_LIMIT_SOCKET_JOIN_MAX=20
RATE_LIMIT_SOCKET_JOIN_WINDOW_MS=60000
RATE_LIMIT_WS_MAX=30
RATE_LIMIT_WS_WINDOW_MS=10000
CLEANUP_BATCH_SIZE=500
PORT=3000
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
VITE_LEGAL_CONTROLLER_NAME=
VITE_PRIVACY_EMAIL=
VITE_GA_MEASUREMENT_ID=
